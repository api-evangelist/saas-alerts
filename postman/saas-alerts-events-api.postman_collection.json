    "_postman_id": "3818084c-20ea-4707-a5c9-829a6d65870e",
    "name": "SaaS Alerts Events API",
    "description": "The SaaS Alerts API provides programmatic access to the SaaS Alerts security monitoring platform for MSPs. The API enables querying of security events, alerts, and user behavior data detected across monitored SaaS applications including Microsoft 365, Google Workspace, Salesforce, Slack, and Dropbox. Authentication uses API keys generated from the SaaS Alerts management interface.\n\nContact Support:\n Name: SaaS Alerts Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:49:42.000Z",
