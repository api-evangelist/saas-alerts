                  "key": "eventType",
                  "value": "<string>",
                  "description": "Filter by event type"
                },
                {
                  "disabled": false,
                  "key": "alertStatus",
                  "value": "<string>",
                  "description": "Filter by alert severity"
                },
                {
                  "disabled": false,
                  "key": "startDate",
