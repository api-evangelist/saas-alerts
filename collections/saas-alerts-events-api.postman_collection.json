                  "description": "Filter by MSP customer/tenant identifier"
                },
                {
                  "disabled": false,
                  "key": "application",
                  "value": "<string>",
                  "description": "Filter by monitored SaaS application"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "25",
                  "description": "Number of events per page (max 100)"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                }
              ],
              "variable": []
            },
